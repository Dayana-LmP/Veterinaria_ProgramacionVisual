<Window x:Class="ProyectoVeterinaria.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:customcontrols="clr-namespace:ProyectoVeterinaria.CustomControls"
        xmlns:viewModel="clr-namespace:ProyectoVeterinaria.ViewModel"
        Title="Huella Soft" Height="500" Width="850"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Window.DataContext>
        <viewModel:LoginViewModel/>
    </Window.DataContext>

    <Border CornerRadius="20" Background="White" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="60,0">
                <TextBlock Text="Huella Soft" FontSize="35" FontWeight="Bold" Foreground="#0644A7" Margin="0,0,0,30"/>

                <TextBlock Text="User name" Foreground="Gray" Margin="0,10,0,5"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="35" VerticalContentAlignment="Center" BorderBrush="#9FCEEC" BorderThickness="0,0,0,2"/>

                <TextBlock Text="Password" Foreground="Gray" Margin="0,20,0,5"/>
                <customcontrols:BindablePasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Height="35"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#D7596D" FontSize="12" FontWeight="Medium"
                           Margin="0,10,0,0" TextWrapping="Wrap"/>

                <Button Command="{Binding LoginCommand}"
                        Content="Login" Margin="0,40,0,0" Height="45" Background="#2375B1" Foreground="White" FontSize="16" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Command="{Binding ShowRegisterCommand}"
                        Content="Crear cuenta" Foreground="#2375B1" FontSize="12" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Margin="0,15,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#2375B1">
                <StackPanel VerticalAlignment="Center" Margin="40">
                    <TextBlock Text="Servicio Veterinario."
                               Foreground="White" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30"/>
                    <Ellipse Width="120" Height="120" HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Images/vet.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Veterinaria Huella Soft" Foreground="#9FCEEC" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <Button Content="—" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="Gray" FontWeight="Bold" Click="btnMinimizar_Click"/>
                <Button Content="X" Width="30" Height="30" Background="#D7596D" BorderThickness="0" Foreground="White" FontWeight="Bold" Margin="5,0,0,0" Click="btnClose_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>