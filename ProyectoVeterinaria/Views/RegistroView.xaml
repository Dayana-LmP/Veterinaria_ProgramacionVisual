<Window x:Class="ProyectoVeterinaria.Views.RegistroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:customcontrols="clr-namespace:ProyectoVeterinaria.CustomControls"
        xmlns:viewModel="clr-namespace:ProyectoVeterinaria.ViewModel"
        Title="Registro" Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <viewModel:RegistroViewModel/>
    </Window.DataContext>

    <Border CornerRadius="20" Background="White" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="60,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Crear cuenta" FontSize="32" FontWeight="Bold" Foreground="#0644A7" Margin="0,0,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Usuario" Foreground="Gray"/>
                        <TextBox Text="{Binding User.Username, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35" Margin="0,5,0,10" VerticalContentAlignment="Center" Padding="5,0"/>

                        <TextBlock Text="Nombre" Foreground="Gray"/>
                        <TextBox Text="{Binding User.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35" Margin="0,5,0,10" VerticalContentAlignment="Center" Padding="5,0"/>

                        <TextBlock Text="Apellido" Foreground="Gray"/>
                        <TextBox Text="{Binding User.LastName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35" Margin="0,5,0,10" VerticalContentAlignment="Center" Padding="5,0"/>

                        <TextBlock Text="Correo electrónico" Foreground="Gray"/>
                        <TextBox Text="{Binding User.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35" Margin="0,5,0,10" VerticalContentAlignment="Center" Padding="5,0"/>

                        <TextBlock Text="Rol" Foreground="Gray"/>
                        <ComboBox SelectedValue="{Binding User.Rol, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content"
                                  Height="35" Margin="0,5,0,10" 
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Recepcionista"/>
                            <ComboBoxItem Content="Veterinario"/>
                            <ComboBoxItem Content="Administrador"/>
                        </ComboBox>

                        <TextBlock Text="Contraseña" Foreground="Gray"/>
                        <customcontrols:BindablePasswordBox
                            Password="{Binding User.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Height="35" Margin="0,5,0,10"/>

                        <TextBlock Text="Confirmar contraseña" Foreground="Gray"/>
                        <customcontrols:BindablePasswordBox
                            Password="{Binding User.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Height="35" Margin="0,5,0,10"/>

                        <TextBlock Text="{Binding ErrorMensage}" Foreground="#D7596D" FontSize="12"
                                   FontWeight="Medium" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <Button Content="REGISTRAR" Command="{Binding AddCommand}" Height="45" Background="#2375B1" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="CANCELAR" Click="btnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Gray"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Background="#2375B1">
                <StackPanel VerticalAlignment="Center" Margin="40">
                    <TextBlock Text="Ingresa a tu cuenta para administrar a los pacientes." Foreground="White" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30"/>
                    <Ellipse Width="120" Height="120" HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Images/vet.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Veterinaria Huella Soft" Foreground="#9FCEEC" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <Button Content="—" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="Gray" FontWeight="Bold" Click="btnMinimizar_Click"/>
                <Button Content="X" Width="30" Height="30" Background="#D7596D" BorderThickness="0" Foreground="White" FontWeight="Bold" Margin="5,0,0,0" Click="btnClose_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>