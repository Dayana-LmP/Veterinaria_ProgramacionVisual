<Window x:Class="ProyectoVeterinaria.Views.ManejoUsuariosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProyectoVeterinaria.ViewModel"
        Title="Gestión de Usuarios"
        Height="600" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.DataContext>
        <vm:ManejoUsuariosViewModel/>
    </Window.DataContext>

    <Border CornerRadius="15" Background="White" Margin="15">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Background="#2375B1" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <DockPanel>
                    <TextBlock Text="Gestión de Usuarios"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Refrescar"
                                Command="{Binding RefreshCommand}"
                                Background="#64B5F6"
                                Foreground="White"
                                Margin="5,0"
                                Width="120"
                                Height="35"/>

                        <Button Content="Agregar"
                                Command="{Binding AddCommand}"
                                Background="#4CAF50"
                                Foreground="White"
                                Margin="5,0"
                                Width="120"
                                Height="35"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- TABLA -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      RowHeight="35"
                      AlternatingRowBackground="#F9F9F9"
                      SelectionMode="Single"
                      GridLinesVisibility="None"
                      BorderThickness="0">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Apellido" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="2*"/>

                    <DataGridTemplateColumn Header="Acciones" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Eliminar"
                                        Command="{Binding DataContext.DeleteCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#D7596D"
                                        Foreground="White"
                                        Width="90"
                                        Height="25"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- FORMULARIO -->
            <Border Grid.Row="2" Background="#F4F6F9" CornerRadius="10" Padding="15" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <StackPanel Margin="10">
                        <TextBlock Text="Usuario" Foreground="Gray"/>
                        <TextBox Width="180"
                                 Text="{Binding SelectedUser.Username, UpdateSourceTrigger=PropertyChanged}"
                                 BorderBrush="#9FCEEC"
                                 BorderThickness="0,0,0,2"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Correo" Foreground="Gray"/>
                        <TextBox Width="220"
                                 Text="{Binding SelectedUser.Email, UpdateSourceTrigger=PropertyChanged}"
                                 BorderBrush="#9FCEEC"
                                 BorderThickness="0,0,0,2"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Nombre" Foreground="Gray"/>
                        <TextBox Width="150"
                                 Text="{Binding SelectedUser.Name, UpdateSourceTrigger=PropertyChanged}"
                                 BorderBrush="#9FCEEC"
                                 BorderThickness="0,0,0,2"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Apellido" Foreground="Gray"/>
                        <TextBox Width="150"
                                 Text="{Binding SelectedUser.LastName, UpdateSourceTrigger=PropertyChanged}"
                                 BorderBrush="#9FCEEC"
                                 BorderThickness="0,0,0,2"/>
                    </StackPanel>

                    <Button Content="Guardar"
                            Command="{Binding EditCommand}"
                            CommandParameter="{Binding SelectedUser}"
                            Background="#2375B1"
                            Foreground="White"
                            Width="130"
                            Height="40"
                            Margin="15,20,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
