<Window x:Class="ProyectoVeterinaria.Views.Consultas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProyectoVeterinaria.Views"
        xmlns:conv="clr-namespace:ProyectoVeterinaria.Converters"
        mc:Ignorable="d"
        Title="Consultas" Height="600" Width="800"
        Background="#F4F7F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2375B1">
            <StackPanel>
                <TextBlock Text="Huella Soft" FontSize="22" FontWeight="Bold" Foreground="White" Margin="20,20,0,30"/>

                <Button Content="🏠  Home" Height="45" Foreground="White" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0644A7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="📋  Consultas" Height="45" Foreground="White" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0644A7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="🐾  Mascotas" Height="45" Foreground="White" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0644A7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="👤  Dueños" Height="45" Foreground="White" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0644A7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="💉  Vacunas" Height="45" Foreground="White" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0644A7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="💊  Medicamentos" Height="45" Foreground="White" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0644A7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="👥  Empleados" Height="45" Foreground="White" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0644A7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Margin="10,150,10,0">
                    <Button Content="↪ Salir" Height="45" Foreground="White" BorderThickness="0" RenderTransformOrigin="0.502,0.195">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0644A7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid Width="250" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBox x:Name="txtBusqueda" 
                                 Padding="5,2"
                                 VerticalContentAlignment="Center"
                                 Height="30" 
                                 TextChanged="TextBox_TextChanged"/>

                        <TextBlock Text="🔍 Buscar Paciente" 
                                   Foreground="DarkGray"
                                   IsHitTestVisible="False" 
                                   Margin="8,0,0,0" 
                                   VerticalAlignment="Center" 
                                   Visibility="{Binding Text, ElementName=txtBusqueda, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </Grid>

                    <Ellipse Width="40" Height="40" HorizontalAlignment="Right" Margin="0,0,20,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Images/vet.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="40">
                    <TextBlock Text="Consulta" FontSize="36" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border Background="White" Padding="25" Width="500" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Nombre de la mascota"/>
                            <TextBox x:Name="txtMascota" Height="30" Margin="0,5,0,15"/>

                            <TextBlock Text="Nombre del dueño"/>
                            <TextBox x:Name="txtDueno" Height="30" Margin="0,5,0,15"/>

                            <TextBlock Text="Servicio a solicitar"/>
                            <TextBox x:Name="txtServicio" Height="30" Margin="0,5,0,15"/>

                            <TextBlock Text="¿Requiere alguna vacuna?" Margin="0,10,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="SI" Width="60" Height="30" Background="#C6D9F1" Margin="0,0,10,0" Click="BtnSi_Click"/>
                                <Button Content="NO" Width="60" Height="30" Background="#F4CCCC" Click="BtnNo_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="GUARDAR" Width="120" Height="35" Background="#4A86E8" Foreground="White" Margin="0,20,0,20" Click="Guardar_Click"/>

                    <DataGrid x:Name="dgConsultas" Height="200" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mascota" Binding="{Binding Mascota}" Width="*"/>
                            <DataGridTextColumn Header="Veterinario" Binding="{Binding Veterinario}" Width="*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>