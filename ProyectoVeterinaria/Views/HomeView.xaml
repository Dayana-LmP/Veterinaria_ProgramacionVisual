<Window x:Class="ProyectoVeterinaria.Views.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home" Height="800" Width="1000"
        Background="#EAF4F4"
        FontFamily="Segoe UI">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= NAVBAR ================= -->
        <Border Background="#2375B1" Grid.Row="0">

            <Grid Margin="30,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LOGO -->
                <TextBlock Text="🐾 Huella Soft"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="White"/>

                <!-- MENU -->
                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            VerticalAlignment="Center">

                    <Button Content="Home" Margin="10,0" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnHome_Click"/>
                    <Button Content="Consultas" Margin="10,0" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnConsultas_Click"/>
                    <Button Content="Mascotas" Margin="10,0" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnMascotas_Click"/>
                    <Button Content="Dueños" Margin="10,0" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnDueno_Click"/>
                    <Button Content="Medicamentos" Margin="10,0" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnMedicamentos_Click"/>
                    <Button Content="Empleados" Margin="10,0" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnEmpleados_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================= CONTENIDO ================= -->
        <Grid Grid.Row="1" Margin="40">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TEXTO -->
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="CLÍNICA"
                           FontSize="25"
                           Foreground="#2375B1"
                           FontWeight="SemiBold"/>

                <TextBlock Text="VETERINARIA"
                           FontSize="50"
                           FontWeight="Bold"
                           Margin="0,10,0,10"/>

                <Border Background="#2375B1"
                        CornerRadius="20"
                        Padding="10"
                        Margin="0,10,0,10"
                        Width="330">

                    <TextBlock Text="La salud de tu mascota en nuestras manos"
                               TextAlignment="Center"
                               FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <TextBlock Text="Sistema de gestión veterinaria moderno y sencillo."
                           Width="300"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

            </StackPanel>

            <!-- IMAGEN -->
            <Grid Grid.Column="1">

                <Ellipse Width="350"
                         Height="350"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">

                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/Images/vet.png"
                                    Stretch="UniformToFill"/>
                    </Ellipse.Fill>

                </Ellipse>

            </Grid>

        </Grid>

    </Grid>

</Window>
